# Twilio SendGrid — copy to .env and fill SENDGRID_API_KEY
# Never commit a real API key.

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notify@omnidigitalsuite.com
SENDGRID_FROM_NAME=OmniDigitalSuite
SENDGRID_REPLY_TO=notify@omnidigitalsuite.com
SENDGRID_API_URL=https://api.sendgrid.com/v3/mail/send
SENDGRID_ENABLED=true

# Optional live test recipient (only used by sendgrid_test.php when explicitly run)
SENDGRID_TEST_TO=

# KumoMTA / VPS SMTP (third sending method) — direct connection, no SOCKS
# Fill username/password in local .env only. Never commit secrets.

KUMOMTA_ENABLED=true
KUMOMTA_HOST=smtp1.omnidigitalsuite.com
KUMOMTA_PORT=587
KUMOMTA_ENCRYPTION=tls
KUMOMTA_USERNAME=
KUMOMTA_PASSWORD=
KUMOMTA_TIMEOUT=30
KUMOMTA_VERIFY_PEER=true
KUMOMTA_DEFAULT_FROM=mail@omnidigitalsuite.com
KUMOMTA_DEFAULT_FROM_NAME=OmniDigitalSuite
KUMOMTA_DEFAULT_REPLY_TO=mail@omnidigitalsuite.com

# Optional live test recipient (kumomta_test.php --confirm only)
KUMOMTA_TEST_TO=

# Global suppressions / unsubscribe (Phase 3) — shared across all send methods
SUPPRESSION_ENABLED=true
SUPPRESSION_SOFT_BOUNCE_MAX=3
SUPPRESSION_SOFT_BOUNCE_DAYS=14
# Public or LAN URL to unsubscribe.php (required for RFC 8058 one-click)
UNSUBSCRIBE_BASE_URL=
UNSUBSCRIBE_SECRET=
UNSUBSCRIBE_MAILTO=unsub@omnidigitalsuite.com

# Warm-up governor (Phase 4) — primary: KumoMTA campaign sends
# Hourly = rolling 60-minute ATTEMPT cap (server-side). Pace ≈ 180s ⇒ ~20/hour.
# Plans boot PAUSED — Resume from Dashboard only when ready.
WARMUP_ENABLED=true
WARMUP_DEFAULT_DAILY_CAP=50
WARMUP_DEFAULT_HOURLY_CAP=20
WARMUP_MIN_INTERVAL_SECONDS=180
WARMUP_METRIC_MIN_SAMPLE=20
WARMUP_MAX_HARD_BOUNCE_RATE=0.05
WARMUP_MAX_COMPLAINT_RATE=0.002
WARMUP_MAX_FAIL_RATE=0.25
